# Copier ce fichier en ".env" (ignore par git) et adapter si besoin.
# Le jour J, seul ce fichier change : aucune IP ni aucun port n'est ecrit dans le code.

# --- Base Soins (creee par la tache 1 : infra/postgres/init/01-soins.sql) ---
# Si PostgreSQL ecoute sur un autre port (ex. POSTGRES_PORT=5433 dans infra/.env), le changer ici aussi.
DB_URL=postgres://localhost:5432/soins
DB_USER=medilink
DB_PASSWORD=medilink

# --- Ports d'ecoute des deux services ---
PATIENT_PORT=8091
COUVERTURE_PORT=8092

# --- Appels sortants du Service Couverture ---
# Demo multi-PC : PATIENT_SERVICE_URL=http://192.168.1.12:8091
PATIENT_SERVICE_URL=http://localhost:8091
# Demo multi-PC : ESB_SOINS_URL=http://192.168.1.12:8081/esb-soins
ESB_SOINS_URL=http://localhost:8081/esb-soins

# mock = reponse simulee (ESB pas encore pret) ; real = appel HTTP reel a l'ESB Soins
ESB_MODE=mock
