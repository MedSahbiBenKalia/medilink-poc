# Copier ce fichier en ".env" (ignoré par git) et adapter si besoin.
# Le jour J, seul ce fichier change : aucune IP ni aucun port n'est écrit dans le code.

# --- Ports d'écoute des deux services ---
SEJOUR_PORT=8093
STOCK_PORT=8094

# --- Base Soins (créée par la tâche 1 : infra/postgres/init/01-soins.sql) ---
# Modifier DB_URL si PostgreSQL écoute sur un autre hôte/port.
DB_URL=postgres://localhost:5432/soins
DB_SOINS=soins

# --- Base Pharmacie (créée par la tâche 1 : infra/postgres/init/02-pharmacie.sql) ---
# Si la base Pharmacie est sur un autre serveur, remplacer DB_URL ci-dessous.
# Pour l'instant les deux BDD partagent la même instance PostgreSQL.
DB_PHARMACIE=pharmacie

# --- Identifiants PostgreSQL (communs aux deux bases) ---
DB_USER=medilink
DB_PASSWORD=medilink

# --- ESB Soins (événement "sortie validée") ---
# mock = réponse simulée (ESB pas encore prêt) ; real = appel HTTP réel à l'ESB Soins
ESB_MODE=mock
ESB_SOINS_URL=http://localhost:8081/esb-soins

# --- RabbitMQ (événement stockSousSeuil) ---
RABBITMQ_URL=amqp://medilink:medilink@localhost:5672
RABBITMQ_EXCHANGE=soins.evenements
RABBITMQ_ROUTING_KEY=stock.sous-seuil

# Intervalle de polling de la table Outbox (ms) : toutes les 5 secondes par défaut
STOCK_OUTBOX_POLL_MS=5000
